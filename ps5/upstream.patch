+/* ── LOD distance (0x000A33F0) ────────────────────────────────
+ *
+ * thiscall (view at [esp+4]), ret 16. Sets a view up from its camera (view
+ * +0x40) and stores the view's H at +0xC: sub_000A33A0's (640/2) /
+ * tan(fov/2), the title's own columns. H serves the pixel-size tests
+ * (sub_00098370, sub_00098420 and copies inlined in the renderers): an
+ * object's size on screen picks the LOD of cars, traffic and scenery and
+ * drops what is too small to see. Rendered at k times the title's
+ * resolution, the switches show right in front of the car.
+ * NFSU2_LOD_SCALE=<k> (1, 2, 4 or 8, default 1; the PS5 build sets 8;
+ * lod= in nfsu2x_options.txt wins) scales H so they come k times farther
+ * away. A view without a camera gets no H. Same
+ * as NFSU1's sub_00018E60. */
+extern void sub_000A33F0_gen(void);
+
+static const int s_lod_lvl[] = { 1, 2, 4, 8 };
+static int s_lod_idx = -1;              /* -1: NFSU2_LOD_SCALE not read yet */
+static float lod_scale(void)
+{
+    if (s_lod_idx < 0) {
+        const char *e = getenv("NFSU2_LOD_SCALE");
+        int k = e ? atoi(e) : 1, i;
+        s_lod_idx = 0;
+        for (i = 0; i < 4; i++)
+            if (s_lod_lvl[i] <= k)
+                s_lod_idx = i;
+    }
+    return (float)s_lod_lvl[s_lod_idx];
+}
+
+void sub_000A33F0(void)
+{
+    uint32_t v = MEM32(esp + 4);
+    int camera = MEM32(v + 0x40) != 0;
+    sub_000A33F0_gen();
+    if (camera && lod_scale() != 1.0f) {
+        float h;
+        memcpy(&h, (void *)XBOX_PTR(v + 0xC), 4);
+        h *= lod_scale();
+        memcpy((void *)XBOX_PTR(v + 0xC), &h, 4);
+    }
+}
