+BOOL xbox_ProtectGuestRange(PVOID base,SIZE_T size,DWORD protect,PDWORD old)
+{
+    uintptr_t page=0x4000,access=protect&255;
+    if(access==PAGE_NOACCESS || access==PAGE_READONLY || access==PAGE_EXECUTE || access==PAGE_EXECUTE_READ) {
+        uintptr_t start=((uintptr_t)base+page-1)&~(page-1),end=((uintptr_t)base+size)&~(page-1);
