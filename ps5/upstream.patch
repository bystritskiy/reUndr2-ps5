+int nfsu2_opt_steps(int id)
+{
+    switch (id) {
+    case NFSU2_OPT_SCALE: return N_SCALES;
+    case NFSU2_OPT_ANISO: return 5;
+    case NFSU2_OPT_LOD: return 4;
+    case NFSU2_OPT_VIBRATION: return 11;
+    case NFSU2_OPT_BLUR: return 3;
+#ifdef NFSU2_PS5
+    case NFSU2_OPT_SPEAKER_TEST: return 10;
+#else
+    case NFSU2_OPT_SPEAKERS: case NFSU2_OPT_SPEAKER_TEST: return 0;
+#endif
+    default: return id >= 0 && id < NFSU2_OPT_COUNT ? 2 : 0;
+    }
+}
+
+int nfsu2_opt_get(int id)
+{
+    switch (id) {
+    case NFSU2_OPT_SCALE: return s_scale_idx;
+    case NFSU2_OPT_FXAA: return s_fxaa;
+    case NFSU2_OPT_ANISO: return s_aniso_idx;
+    case NFSU2_OPT_SQUARE: return s_square;
+    case NFSU2_OPT_REFLECTIONS: return s_refl;
+    case NFSU2_OPT_LOD: lod_scale(); return s_lod_idx;
+    case NFSU2_OPT_GRID3D: return nv2a_vk_grid3d > 0;
+    case NFSU2_OPT_FPS: return fps_cap_30();
+    case NFSU2_OPT_OVERLAY: return nfsu2_port_overlay;
+    case NFSU2_OPT_PAUSE: return s_port_pause;
+    case NFSU2_OPT_VIBRATION: return s_vib_idx;
+    case NFSU2_OPT_BLUR: return s_blur;
+    case NFSU2_OPT_TEXT_LANG: return s_lang_sel[0];
+    case NFSU2_OPT_VOICE_LANG: return s_lang_sel[1];
+#ifdef NFSU2_PS5
+    case NFSU2_OPT_SPEAKERS: return s_speakers;
+    case NFSU2_OPT_SPEAKER_TEST: return s_speaker_test;
+#endif
+    }
+    return 0;
+}
+
+void nfsu2_opt_set(int id, int v)
+{
+    int n = nfsu2_opt_steps(id);
+    if (n <= 0)
+        return;
+    v = v < 0 ? 0 : v >= n ? n - 1 : v;
+    switch (id) {
+    case NFSU2_OPT_SCALE: s_scale_idx = v; scale_changed(); break;
+    case NFSU2_OPT_FXAA: s_fxaa = v; picture_changed(); break;
+    case NFSU2_OPT_ANISO: s_aniso_idx = v; picture_changed(); break;
+    case NFSU2_OPT_SQUARE: s_square = v; picture_changed(); break;
+    case NFSU2_OPT_REFLECTIONS: s_refl = v; refl_changed(); break;
+    case NFSU2_OPT_LOD: s_lod_idx = v; break;
+    case NFSU2_OPT_GRID3D: nv2a_vk_grid3d = v; break;
+    case NFSU2_OPT_FPS: s_fps30 = v; break;
+    case NFSU2_OPT_OVERLAY: nfsu2_port_overlay = v; break;
+    case NFSU2_OPT_PAUSE: s_port_pause = v; break;
+    case NFSU2_OPT_VIBRATION: s_vib_idx = v; vib_changed(); break;
+    case NFSU2_OPT_BLUR: s_blur = v; blur_changed(); break;
+    case NFSU2_OPT_TEXT_LANG: s_lang_sel[0] = v; lang_changed(); break;
+    case NFSU2_OPT_VOICE_LANG: s_lang_sel[1] = v; lang_changed(); break;
+#ifdef NFSU2_PS5
+    case NFSU2_OPT_SPEAKERS: s_speakers = v; speakers_changed(); break;
+    case NFSU2_OPT_SPEAKER_TEST: s_speaker_test = v; speakers_changed(); break;
+#endif
+    }
+}
+
+const char *nfsu2_lang_choice_utf8(int kind, int choice, char *buf, unsigned cap);
+
+const char *nfsu2_opt_lang_text(int id, int v, char *buf, unsigned cap)
+{
+    return nfsu2_lang_choice_utf8(id == NFSU2_OPT_VOICE_LANG, v, buf, cap);
+}
+
+int nfsu2_opt_shown(int id)
+{
+    switch (id) {
+    case NFSU2_OPT_TEXT_LANG: return nfsu2_lang_has(0);
+    case NFSU2_OPT_VOICE_LANG: return nfsu2_lang_has(1);
+    default: return nfsu2_opt_steps(id) > 0;
+    }
+}
+
+void nfsu2_opt_save(void)
+{
+    options_save();
+    options_log();
+}
